# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
APP_ENV=development
PORT=4000
APP_NAME="Project5"

# IANA timezone applied to the whole backend process (process.env.TZ), so every
# rendered timestamp, log line and naive date parse uses one zone regardless of
# the host. Stored timestamps are UNIX epoch seconds and are absolute, so this
# changes how instants are displayed, never what is stored.
# Defaults to UTC when unset; an unrecognised value logs an error and uses UTC.
APP_TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------
# API versioning (URI-based). Controllers with no explicit @Controller
# version fall back to this. Ex. API_VERSION=1 -> /api/v1/...
# ------------------------------------------------------------------
API_VERSION=1

# ------------------------------------------------------------------
# Database (driver-based: mysql | postgresql)
# Keep DATABASE_PROVIDER in sync with prisma/schema.prisma `provider`.
# MySQL (current):
#   DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB"
# PostgreSQL (later):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# ------------------------------------------------------------------
DATABASE_PROVIDER=mysql
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/project5_db"

# ------------------------------------------------------------------
# JWT / Auth
# ------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-3f9a1c
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-7b2e8d
JWT_REFRESH_EXPIRES_IN=7d

# Cookies (refresh token / CSRF). Set COOKIE_SECURE=true behind HTTPS.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------
# CORS (comma separated origins)
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# Public base URL of this API, including the /api/v1 prefix, as streaming
# servers reach it - used for their event webhook. Leave empty to disable
# stream events. A local backend needs a tunnel (cloudflared, ngrok) here.
PUBLIC_API_URL=

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ------------------------------------------------------------------
# Storage (local | s3). When STORAGE_DRIVER=s3, S3_* vars are required.
# Only the file PATH is stored in DB, never a full URL.
# ------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=public/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ------------------------------------------------------------------
# Swagger
# ------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

ENCRYPTION_KEY=dev-encryption-key-change-me-in-production-1a2b3c
