# App
NODE_ENV=development
PORT=4000
APP_NAME="Project5 System API"

# Database (driver-based: mysql | postgresql)
# Keep DATABASE_PROVIDER in sync with prisma/schema.prisma `provider`.
DATABASE_PROVIDER=mysql
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/project5_db"

# JWT / Auth
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# CORS (comma separated)
CORS_ORIGINS=http://localhost:3000

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Storage (local | s3) — only the file PATH is stored in DB, never a URL
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=public/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
