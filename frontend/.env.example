# Base URL of the backend REST API (versioned)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Application brand name shown in the browser tab title and in-app branding
# (sidebar brand mark, login/register cards). Keep in sync with backend's
# APP_NAME so both sides of the stack show the same product name.
NEXT_PUBLIC_APP_NAME=Project5

# OpenStreetMap tile server used by the location picker map (no API key required).
# Override to point at a self-hosted tile server if needed.
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
